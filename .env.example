# Optional environment configuration for Stalker++ (copy to .env if desired)
# API keys can also be added directly inside the UI (encrypted at rest via Fernet).

STALKER_DB_PATH=data/stalker_pp.db
STALKER_LLM_PROVIDER=none
STALKER_OLLAMA_BASE_URL=http://localhost:11434
STALKER_OLLAMA_MODEL=qwen2.5:7b

# Optional: set a custom 32-byte url-safe base64 Fernet master key
# STALKER_MASTER_KEY=
