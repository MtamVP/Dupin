{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dupin",
  "version": "2.0.0",
  "identifier": "com.dupin.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dupin — Local-First Multi-Agent OSINT Co-Pilot",
        "width": 1380,
        "height": 880,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "backgroundColor": "#f7f7f4"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
