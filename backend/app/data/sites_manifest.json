{
  "schema_version": "maigret-compat-2.0",
  "description": "Declarative public OSINT site & engine registry inspired by soxoj/maigret and sherlock-project/sherlock (5 reusable engines, 55 platforms, rank priority, response_url Soft-404 checks). Drop custom Maigret/Sherlock JSON into backend/data/custom_sites.json to extend coverage dynamically.",
  "engines": {
    "DiscourseJson": {
      "probe_suffix": "/u/{username}.json",
      "profile_suffix": "/u/{username}",
      "mode": "discourse_json"
    },
    "WordpressAuthor": {
      "probe_suffix": "/wp-json/wp/v2/users?slug={username}",
      "profile_suffix": "/author/{username}/",
      "mode": "wordpress_json"
    },
    "MastodonApi": {
      "probe_suffix": "/api/v1/accounts/lookup?acct={username}",
      "profile_suffix": "/@{username}",
      "mode": "mastodon_json"
    },
    "GiteaApi": {
      "probe_suffix": "/api/v1/users/{username}",
      "profile_suffix": "/{username}",
      "mode": "gitea_json"
    },
    "BlueskyApi": {
      "probe_suffix": "/xrpc/app.bsky.actor.getProfile?actor={username}.bsky.social",
      "profile_suffix": "/profile/{username}.bsky.social",
      "mode": "bluesky_json"
    }
  },
